# App Configuration
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Security, CORS & Rate Limiting
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
API_KEY= # Optional: If set, enforces X-API-Key or Bearer header authentication
RATE_LIMIT_RPM=120
MAX_UPLOAD_SIZE_MB=10

# Database & Vector Store
# Production default: postgresql://postgres:postgres@localhost:5432/rag_db
# Local zero-dependency fallback: sqlite:///./rag_app.db
DATABASE_URL=sqlite:///./rag_app.db
DB_ECHO=false

# Redis Cache (Atomic index_version invalidation)
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=false
CACHE_TTL_SECONDS=3600

# LLM Providers (Options: anthropic, openai, mock)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022

# Embeddings
EMBEDDING_PROVIDER=sentence_transformers # Options: sentence_transformers, openai, mock
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu # Options: cpu, cuda

# Re-ranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu

# Ingestion Defaults
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=100
DEFAULT_CHUNKING_STRATEGY=sentence # Options: fixed, sentence, semantic

# Retrieval & Grounding Quality Controls
RELEVANCE_THRESHOLD=0.20
QUERY_REWRITING_ENABLED=true
CITATION_VERIFICATION_ENABLED=true
RRF_K=60
DEFAULT_CANDIDATE_K=20
DEFAULT_TOP_K=5
