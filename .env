# App Configuration
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Zero-Docker Database: Local SQLite file
DATABASE_URL=sqlite:///./rag_app.db
DB_ECHO=false

# Caching (Disabled for Zero-Docker mode or use in-process cache)
CACHE_ENABLED=false
CACHE_TTL_SECONDS=3600

# LLM Providers (Mock by default, or set your API key)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=mock
LLM_MODEL=claude-3-5-sonnet-20241022

# Embeddings (Local sentence-transformers, no external API needed)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu

# Re-ranker (Local cross-encoder, no external API needed)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu

# Ingestion Defaults
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=100
DEFAULT_CHUNKING_STRATEGY=sentence
